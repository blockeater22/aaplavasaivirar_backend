{
  "version": 2,
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/health.mjs": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/index.mjs": {
      "maxDuration": 10,
      "memory": 1024
    }
  }
}
