{
  "version": 2,
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/((?!api/).*)", "destination": "/api/index?__vp=$1" }
  ],
  "functions": {
    "api/health.mjs": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
