# AaplaVasaiVirar Backend — copy to .env and fill values

NODE_ENV=development
PORT=3000

# Database (Supabase or standalone Postgres with PostGIS)
# Supabase: Project Settings → Database → URI (pooler 6543 or direct 5432). Run CREATE EXTENSION postgis;
DATABASE_URL=postgresql://user:password@localhost:5432/vvmc

# JWT
JWT_SECRET=your-strong-secret-min-32-chars
JWT_VOLUNTEER_AUD=volunteer
JWT_USER_AUD=user
JWT_ADMIN_AUD=admin

# SMS — Fast2SMS or MSG91
SMS_PROVIDER=fast2sms
SMS_API_KEY=
SMS_SENDER_ID=VVMCOT

# Optional: file storage label for KYC (local disk paths; see kycUpload config)
STORAGE_BUCKET_KYC=kyc-docs

# Rate limits (OTP per phone per hour)
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_TTL_MINUTES=10

# ImageKit — shop listing photos (required for image uploads; DB stays on Supabase Postgres)
# https://imagekit.io → Dashboard → API keys
IMAGEKIT_PUBLIC_KEY=public_xxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Marketing site: POST /whitelist is public (no JWT). Rows land in whitelist_signups after migration 015.
